{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "redirects": [
      { "source": "/movies", "destination": "/", "type": 301 },
      { "source": "/books", "destination": "/", "type": 301 },
      { "source": "/book/**", "destination": "/", "type": 301 }
    ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
